PORT=3000

DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=change-me
DB_DATABASE=tesispro
# En local puede ser false; en Vercel usar true.
DB_SSL=false
# Certificado PEM del proveedor, con saltos reales o representados como \n.
DB_SSL_CA=
DB_POOL_MAX=2
DB_CONNECT_TIMEOUT_MS=10000
DB_LOGGING=false
DB_RUN_MIGRATIONS=false
APP_ORIGIN=http://localhost:4321
NODE_ENV=development
# R4: primera referencia válida durante 1 a 90 días; propuesta pendiente de aprobación comercial.
REFERRAL_TTL_DAYS=30

# Debe coincidir con la clave configurada en Astro.
CRM_BRIDGE_SECRET=
R8_AI_URL=http://localhost:4321/api/internal/proposal

# Activar después de aplicar las migraciones y configurar el mismo flag en Astro.
AGENTS_ENABLED=false
AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
# Secreto independiente (mínimo 32 caracteres) para POST /internal/agents/jobs/reminders.
AGENTS_JOB_SECRET=
## Google Calendar (solo backend; nunca PUBLIC_ ni VITE_)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://tesispro-backend.vercel.app/integrations/google/callback
# Generar una vez: node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"
GOOGLE_TOKEN_ENCRYPTION_KEY=
# Opcional: también puede guardarse desde el panel después de conectar Google.
GOOGLE_CALENDAR_ID=
# URL fija del panel al terminar OAuth; usar la URL real del frontend en producción.
CALENDAR_ADMIN_URL=http://localhost:4321/admin/reuniones
