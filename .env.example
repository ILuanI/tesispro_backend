PORT=3000

DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=change-me
DB_DATABASE=tesispro
# En local puede ser false; en Vercel usar true.
DB_SSL=false
# Certificado PEM del proveedor, con saltos reales o representados como \n.
DB_SSL_CA=
DB_POOL_MAX=2
DB_CONNECT_TIMEOUT_MS=10000
DB_LOGGING=false
DB_RUN_MIGRATIONS=false
APP_ORIGIN=http://localhost:4321
NODE_ENV=development
# R4: primera referencia válida durante 1 a 90 días; propuesta pendiente de aprobación comercial.
REFERRAL_TTL_DAYS=30

# Debe coincidir con la clave configurada en Astro.
CRM_BRIDGE_SECRET=
R8_AI_URL=http://localhost:4321/api/internal/proposal
