# =============================================================================
#  TESISPRO · BACKEND (NestJS) · Variables de entorno
# =============================================================================
#  Copia este archivo a `.env` y completa los valores reales.
#
#  Leyenda de cada variable:
#    [AMBOS]       Se usa en local y en producción (con valores distintos).
#    [LOCAL]       Solo tiene sentido en desarrollo local.
#    [PRODUCCIÓN]  Solo se necesita (o cambia de valor) en producción (Vercel).
#    OBLIGATORIA   Sin ella la app no arranca o la funcionalidad falla.
#    OPCIONAL      Tiene valor por defecto o solo activa una función extra.
#
#  Nota: Vercel define automáticamente VERCEL=1. NO la configures a mano;
#  el backend la usa para exigir DB_* y DB_SSL=true, desactivar migraciones
#  automáticas y reducir el pool de conexiones.
# =============================================================================


# -----------------------------------------------------------------------------
#  1. SERVIDOR
# -----------------------------------------------------------------------------
# [LOCAL] OPCIONAL · Puerto HTTP local (por defecto 3000). Vercel lo ignora.
PORT=3000

# [AMBOS] OBLIGATORIA · "development" en local, "production" en Vercel.
# En producción activa las cookies `Secure` (sesión admin, referidos, contacto).
NODE_ENV=development

# [AMBOS] OBLIGATORIA · URL exacta del frontend (Astro), sin barra final.
# Se valida contra el header Origin en el login del panel y se usa en redirecciones.
#   Local:       http://localhost:4321
#   Producción:  https://<tu-frontend>.vercel.app
APP_ORIGIN=http://localhost:4321


# -----------------------------------------------------------------------------
#  2. BASE DE DATOS (PostgreSQL)
# -----------------------------------------------------------------------------
# [AMBOS] OBLIGATORIAS · En producción (VERCEL=1) el backend NO arranca si falta alguna.
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=
DB_DATABASE=tesispro

# [AMBOS] OBLIGATORIA en producción · Local: false · Producción: true (obligatorio en Vercel).
DB_SSL=false
# [PRODUCCIÓN] OPCIONAL · Certificado CA (PEM) del proveedor si lo exige.
# Puede ir con saltos de línea reales o escapados como \n.
DB_SSL_CA=

# [AMBOS] OPCIONAL · Máx. conexiones del pool. Por defecto: 10 local / 2 en Vercel.
DB_POOL_MAX=2
# [AMBOS] OPCIONAL · Timeout de conexión en ms (por defecto 10000).
DB_CONNECT_TIMEOUT_MS=10000
# [LOCAL] OPCIONAL · true para ver las consultas SQL en consola.
DB_LOGGING=false
# [LOCAL] OPCIONAL · true ejecuta las migraciones al arrancar. En Vercel se ignora
# (allí hay que migrar manualmente antes de desplegar).
DB_RUN_MIGRATIONS=false


# -----------------------------------------------------------------------------
#  3. PUENTE BACKEND ↔ FRONTEND (Astro)
# -----------------------------------------------------------------------------
# [AMBOS] OBLIGATORIA · Secreto compartido con Astro (mín. 32 caracteres).
# Debe ser IDÉNTICO al CRM_BRIDGE_SECRET del frontend. Protege /internal/*,
# por donde Astro reenvía la FAQ con IA y el chat de Tesi.
# Generar: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
CRM_BRIDGE_SECRET=


# -----------------------------------------------------------------------------
#  4. INTELIGENCIA ARTIFICIAL (toda la IA del proyecto vive aquí)
# -----------------------------------------------------------------------------
#  Con UNA clave y UN modelo funcionan los 6 roles: el orquestador (elige el
#  agente según el mensaje) y los agentes marketing, negociador, cobranza,
#  académico y postventa. Cada agente es el mismo modelo con otras
#  instrucciones y herramientas. Los demás proveedores son solo respaldo.
#
#  Las respuestas instantáneas de la FAQ (saludos, temas ajenos, consultas
#  comerciales) son reglas fijas: no usan IA ni necesitan claves.
#
#  [AMBOS] OBLIGATORIA · Al menos UNA clave con su modelo. Si no hay ninguna,
#  la FAQ con IA y el chat de Tesi responden "no disponible".
#  Los modelos de Groq y OpenRouter deben admitir salida estructurada
#  (response_format json_schema).

# --- OpenRouter (https://openrouter.ai/keys) ---
OPENROUTER_API_KEY=
# Modelo por defecto, formato "organización/modelo", p. ej. meta-llama/llama-3.3-70b-instruct
OPENROUTER_MODEL=

# --- Groq (https://console.groq.com/keys) ---
GROQ_API_KEY=
# Modelo por defecto, p. ej. openai/gpt-oss-120b
GROQ_MODEL=

# --- Gemini (https://aistudio.google.com/apikey) ---
GEMINI_API_KEY=
# Modelo por defecto (si se deja vacío: gemini-3.8-flash).
GEMINI_MODEL=gemini-3.8-flash

# [AMBOS] OPCIONAL · Orden de respaldo. Si un proveedor
# falla (cuota, crédito, caída, modelo no válido) se prueba el siguiente.
# Se omiten los que no tienen clave o modelo. Por defecto: openrouter,groq,gemini
AI_PROVIDER_ORDER=openrouter,groq,gemini

# [PRODUCCIÓN] OBLIGATORIA si se programan recordatorios (cron) · Secreto
# (mín. 32 caracteres) para POST /internal/agents/jobs/reminders
# (header: Authorization: Bearer <secreto>).
AGENTS_JOB_SECRET=


# -----------------------------------------------------------------------------
#  5. GOOGLE CALENDAR (reuniones) · solo backend, nunca PUBLIC_ / VITE_
# -----------------------------------------------------------------------------
# [AMBOS] OBLIGATORIAS para el módulo de reuniones · Credenciales OAuth de Google Cloud.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# [AMBOS] OBLIGATORIA · Debe estar registrada en Google Cloud Console.
#   Local:       http://localhost:3000/integrations/google/callback
#   Producción:  https://<tu-backend>.vercel.app/integrations/google/callback
GOOGLE_REDIRECT_URI=http://localhost:3000/integrations/google/callback

# [AMBOS] OBLIGATORIA · Clave base64 de 32 bytes para cifrar los tokens de Google.
# Generar UNA vez y no cambiarla (invalidaría la conexión guardada):
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"
GOOGLE_TOKEN_ENCRYPTION_KEY=

# [AMBOS] OPCIONAL · ID del calendario; también se puede configurar desde el panel.
GOOGLE_CALENDAR_ID=

# [AMBOS] OPCIONAL (recomendada) · A dónde vuelve el usuario tras el OAuth.
#   Local:       http://localhost:4321/admin/reuniones
#   Producción:  https://<tu-frontend>.vercel.app/admin/reuniones
CALENDAR_ADMIN_URL=http://localhost:4321/admin/reuniones


# -----------------------------------------------------------------------------
#  6. WHATSAPP CLOUD API (Meta) · solo backend
# -----------------------------------------------------------------------------
#  Flujo: Meta envía cada mensaje al webhook /webhooks/whatsapp -> se guarda y se
#  responde 200 -> en segundo plano Tesi lo procesa con el orquestador y los
#  agentes (sección 4) -> se responde por la API de Meta.
#
#  - Ventana de 24 h (regla de Meta): solo se responde si el último mensaje del
#    usuario tiene menos de 24 h. Tesi siempre contesta a un mensaje entrante,
#    así que no se usan plantillas.
#  - Identidad: el sender_id de Meta identifica al contacto. El primer mensaje
#    crea un buyer (canal WhatsApp) o se vincula al buyer/lead con ese teléfono.
#  - Clasificación automática: buyer -> lead «nuevo» cuando Tesi identifica una
#    necesidad calificada o interés de compra; lead -> «calificado» ->
#    «en_negociacion». Cliente (pagó/contrato), propuesta enviada y perdido
#    los sigue decidiendo el equipo comercial.
#  - Sin IA (sin claves, cupo agotado o error del proveedor) responde por reglas.
#
#  En Meta: configura el webhook con
#    URL:          https://<tu-backend>.vercel.app/webhooks/whatsapp
#    Verify token: el valor de WHATSAPP_VERIFY_TOKEN
#    Campo:        messages
#  En local el webhook necesita una URL pública (ngrok, cloudflared, etc.).

# [AMBOS] OBLIGATORIA para usar WhatsApp · "true" activa el módulo. Si alguna
# variable OBLIGATORIA falta o es inválida, el módulo responde 503.
WHATSAPP_ENABLED=false

# OBLIGATORIA · ID numérico del número de teléfono (Meta > WhatsApp > API Setup).
WHATSAPP_PHONE_NUMBER_ID=
# OPCIONAL · ID numérico; obligatorio si el token accede a varias cuentas en ese número.
WHATSAPP_MESSAGING_ACCOUNT_ID=
# OBLIGATORIA · Token de acceso (en producción, token permanente de un System User).
WHATSAPP_ACCESS_TOKEN=
# OBLIGATORIA · App Secret de la app de Meta (valida la firma de los webhooks).
WHATSAPP_APP_SECRET=
# OBLIGATORIA · Token propio (mín. 32 caracteres); el mismo se escribe en Meta.
WHATSAPP_VERIFY_TOKEN=
# OBLIGATORIA · Clave base64 de exactamente 32 bytes para cifrar sesiones.
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"
WHATSAPP_SESSION_KEY=
# OPCIONAL · Versión de Graph API, formato vNN.0 (por defecto v27.0).
WHATSAPP_GRAPH_API_VERSION=v27.0

# [LOCAL] OPCIONAL · Vacío = se atiende a CUALQUIER remitente (producción).
# Con valores, solo a esos (útil para pruebas). Separados por coma.
# Formato: número internacional sin "+" (51987654321) o ID de usuario de Meta.
WHATSAPP_ALLOWED_SENDERS=

# --- IA en WhatsApp (usa los modelos y claves de la sección 4) ---
# OPCIONAL · "live" (defecto): orquestador y agentes con IA. "off": solo reglas.
WHATSAPP_AI_MODE=live
# OPCIONAL · Tope de turnos con IA por día (UTC) para controlar costos.
# Al superarlo se responde por reglas. 0 desactiva la IA. Defecto 500.
WHATSAPP_AI_DAILY_LIMIT=500
# OPCIONAL · Minutos sin mensajes tras los que Tesi deja de usar el historial
# reciente de la charla (1-1440, defecto 5). Los datos del contacto y su
# clasificación se conservan siempre.
WHATSAPP_CONTEXT_MINUTES=5

# [PRODUCCIÓN] OPCIONAL · Secreto (mín. 32 caracteres) para que un cron externo
# llame a POST /internal/whatsapp/jobs/process (Authorization: Bearer <secreto>)
# y reintente envíos fallidos. Sin él, los reintentos se hacen al llegar el
# siguiente mensaje.
WHATSAPP_WORKER_SECRET=


# -----------------------------------------------------------------------------
#  7. NEGOCIO / OTROS
# -----------------------------------------------------------------------------
# [AMBOS] OPCIONAL · Días de validez de la referencia de un referido (1-90, defecto 30).
REFERRAL_TTL_DAYS=30

# [LOCAL] OPCIONAL · Ruta a un JSON alternativo de reglas de calificación (R7).
# Vacío = usa config/tesi-qualification.json (recomendado en producción).
R7_RULES_FILE=
